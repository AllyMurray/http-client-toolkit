{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@repo/tsdown-config#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["lib/**", "dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": []
    },
    "@http-client-toolkit/store-dynamodb#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:build": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "lib/**", "build-tests/**"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false,
      "outputs": []
    },
    "@repo/tsdown-config#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  },
  "globalDependencies": [
    "bunfig.toml",
    ".oxlintrc.json",
    "scripts/check-coverage.mjs"
  ]
}
