{
  "name": "@http-client-toolkit/store-sqlite",
  "description": "SQLite store implementations for HTTP client toolkit caching, deduplication, and rate limiting using Drizzle ORM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AllyMurray/http-client-toolkit.git"
  },
  "scripts": {
    "build": "tsup && npm run test",
    "lint": "eslint --fix src && prettier --write .",
    "test": "vitest run --dir=src",
    "test:coverage": "vitest run --dir=src --coverage",
    "test:watch": "vitest --dir=src",
    "dev": "tsup --watch",
    "clean": "rimraf lib dist node_modules .turbo"
  },
  "author": {
    "name": "Ally Murray",
    "email": "allymurray88@gmail.com",
    "organization": false
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tsup-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "^9.39.5",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@http-client-toolkit/core": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7",
    "@types/better-sqlite3": "^9.6.0"
  },
  "keywords": [
    "http-client",
    "sqlite-store",
    "drizzle-orm",
    "caching",
    "deduplication",
    "rate-limiting"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./lib/index.cjs",
  "license": "ISC",
  "sideEffects": false,
  "files": [
    "lib/**"
  ],
  "homepage": "https://github.com/AllyMurray/http-client-toolkit#readme",
  "version": "5.0.0",
  "bugs": {
    "url": "https://github.com/AllyMurray/http-client-toolkit/issues"
  },
  "types": "./lib/index.d.ts",
  "type": "module",
  "module": "./lib/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.16.1"
}
