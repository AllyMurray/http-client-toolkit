{
  "name": "@http-client-toolkit/dashboard",
  "description": "Dashboard UI for monitoring and managing HTTP client toolkit stores",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AllyMurray/http-client-toolkit.git"
  },
  "scripts": {
    "build": "vite build && tsdown && bun run test",
    "lint": "bun lint --no-script src",
    "test": "bun test ./src",
    "test:coverage": "bun test --coverage ./src && node ../../scripts/check-coverage.mjs",
    "test:watch": "bun test --watch ./src",
    "dev": "vite",
    "dev:server": "tsdown --watch",
    "clean": "rimraf lib dist node_modules .turbo",
    "typecheck": "bun check --noEmit"
  },
  "author": {
    "name": "Ally Murray",
    "email": "allymurray88@gmail.com",
    "organization": false
  },
  "devDependencies": {
    "@http-client-toolkit/store-memory": "workspace:*",
    "@http-client-toolkit/store-sqlite": "workspace:*",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "rimraf": "6.1.4",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "@repo/tsdown-config": "workspace:*",
    "tsdown": "0.23.5"
  },
  "dependencies": {
    "@http-client-toolkit/core": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@http-client-toolkit/store-memory": "workspace:^",
    "@http-client-toolkit/store-sqlite": "workspace:^",
    "@http-client-toolkit/store-dynamodb": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@http-client-toolkit/store-memory": {
      "optional": true
    },
    "@http-client-toolkit/store-sqlite": {
      "optional": true
    },
    "@http-client-toolkit/store-dynamodb": {
      "optional": true
    }
  },
  "keywords": [
    "http-client",
    "dashboard",
    "monitoring",
    "caching",
    "rate-limiting"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./lib/index.cjs",
  "license": "ISC",
  "sideEffects": false,
  "files": [
    "lib/**",
    "dist/client/**"
  ],
  "homepage": "https://github.com/AllyMurray/http-client-toolkit#readme",
  "version": "5.0.2",
  "bugs": {
    "url": "https://github.com/AllyMurray/http-client-toolkit/issues"
  },
  "types": "./lib/index.d.ts",
  "type": "module",
  "module": "./lib/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.4"
}
