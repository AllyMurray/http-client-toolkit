{
  "name": "@http-client-toolkit/store-dynamodb",
  "description": "DynamoDB store implementations for HTTP client toolkit caching, deduplication, and rate limiting",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AllyMurray/http-client-toolkit.git"
  },
  "type": "module",
  "version": "5.0.2",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown && bun run test",
    "lint": "bun lint --no-script src",
    "test": "bun test ./src",
    "test:coverage": "bun test --coverage ./src && node ../../scripts/check-coverage.mjs",
    "test:watch": "bun test --watch ./src",
    "dev": "tsdown --watch",
    "clean": "rimraf lib dist node_modules .turbo",
    "typecheck": "bun check --noEmit"
  },
  "dependencies": {
    "@http-client-toolkit/core": "workspace:*",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "aws-sdk-client-mock": "^4.1.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "@repo/tsdown-config": "workspace:*",
    "tsdown": "0.23.5"
  },
  "sideEffects": false,
  "files": [
    "lib/**"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "homepage": "https://github.com/AllyMurray/http-client-toolkit#readme",
  "bugs": {
    "url": "https://github.com/AllyMurray/http-client-toolkit/issues"
  },
  "author": {
    "name": "Ally Murray",
    "email": "allymurray88@gmail.com",
    "organization": false
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.4-canary.20261104.1"
}
