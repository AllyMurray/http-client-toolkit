{
  "name": "http-client-toolkit-monorepo",
  "description": "HTTP client toolkit monorepo with pluggable caching, deduplication, and rate limiting",
  "repository": {
    "type": "git",
    "url": "https://github.com/AllyMurray/http-client-toolkit.git"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:build": "turbo run test:build",
    "lint": "oxlint packages/*/src",
    "lint:fix": "oxlint --fix packages/*/src",
    "pre-commit": "bun run format:check && turbo run lint test --filter=...[HEAD^1]",
    "format": "bun fmt \"**/*.{ts,tsx,md}\"",
    "dashboard": "node --experimental-strip-types packages/dashboard/examples/dev-server.ts",
    "dev": "turbo run dev --parallel",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && bun run release:prepare && changeset publish --from-pack-dir .package-tests",
    "test:package:prepare": "rimraf .package-tests && bun run scripts/pack-packages.mjs",
    "test:package": "node build-tests/installed-package.mjs",
    "typecheck": "bun run --filter \"@http-client-toolkit/*\" typecheck",
    "lint:check": "oxlint packages/*/src",
    "test:dependency-policy": "node build-tests/dependency-policy.test.cjs",
    "audit:dependencies": "bun scripts/audit-dependencies.mjs",
    "test:release": "node build-tests/release.mjs",
    "format:check": "bun fmt --check \"**/*.{ts,tsx,md}\"",
    "release:prepare": "bun run test:package:prepare && node scripts/prepare-publish-plan.mjs"
  },
  "author": {
    "name": "Ally Murray",
    "email": "allymurray88@gmail.com",
    "organization": false
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@typescript/typescript6": "6.0.2",
    "commitizen": "4.3.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "oxlint": "1.92.0",
    "rimraf": "6.1.4",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "license": "ISC",
  "homepage": "https://github.com/AllyMurray/http-client-toolkit#readme",
  "bugs": {
    "url": "https://github.com/AllyMurray/http-client-toolkit/issues"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "rimraf": {
      "glob": "14.0.3"
    }
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "unrs-resolver"
  ]
}
