{
  "name": "http-client-toolkit-monorepo",
  "description": "HTTP client toolkit monorepo with pluggable caching, deduplication, and rate limiting",
  "repository": {
    "type": "git",
    "url": "https://github.com/AllyMurray/http-client-toolkit.git"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "test:build": "turbo run test:build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "pre-commit": "prettier --write . && turbo run lint test --filter=...[HEAD^1]",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "dashboard": "node --experimental-strip-types packages/dashboard/examples/dev-server.ts",
    "dev": "turbo run dev --parallel",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "test:package:prepare": "rimraf .package-tests && pnpm --filter '@http-client-toolkit/*' pack --pack-destination .package-tests",
    "test:package": "node build-tests/installed-package.mjs",
    "typecheck": "pnpm --filter '@http-client-toolkit/*' exec tsc --noEmit",
    "lint:check": "pnpm --filter '@http-client-toolkit/*' exec eslint src",
    "test:dependency-policy": "node build-tests/dependency-policy.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "test:release": "node build-tests/release.mjs"
  },
  "author": {
    "name": "Ally Murray",
    "email": "allymurray88@gmail.com",
    "organization": false
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@repo/eslint-config": "workspace:*",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "commitizen": "4.3.2",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "turbo": "^2.11.10",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "license": "ISC",
  "homepage": "https://github.com/AllyMurray/http-client-toolkit#readme",
  "bugs": {
    "url": "https://github.com/AllyMurray/http-client-toolkit/issues"
  },
  "packageManager": "pnpm@12.16.1",
  "workspaces": [
    "packages/*"
  ]
}
