{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "bun", "github-actions", "bun-version"],
  "dependencyDashboard": true,
  "timezone": "Europe/London",
  "schedule": ["* 0-5 * * *"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": false,
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 * * *"],
    "automerge": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security"],
    "schedule": [],
    "prConcurrentLimit": 0,
    "prCreation": "immediate",
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Automatically merge minor and patch updates after required CI passes.",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Wait 24 hours before proposing ordinary npm updates and reject releases with missing timestamps.",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "1 day",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Prioritize transitive refreshes over ordinary version bumps.",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "prPriority": 10
    },
    {
      "description": "Keep lint and formatting tools together, including dependencies of the private shared config.",
      "matchManagers": ["npm", "bun"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["eslint-*"],
      "groupName": "lint and formatting tools"
    },
    {
      "description": "Coordinate compiler and build updates across workspaces.",
      "matchManagers": ["npm", "bun"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["typescript", "@typescript/typescript6", "tsdown", "tsx", "esbuild", "turbo"],
      "groupName": "typescript and build tooling"
    },
    {
      "description": "Keep the TS6 compiler API on its compatible major version.",
      "matchManagers": ["npm", "bun"],
      "matchPackageNames": ["@typescript/typescript6"],
      "allowedVersions": ">=6.0.0 <7.0.0"
    },
    {
      "matchManagers": ["npm", "bun"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["@types/**"],
      "groupName": "type definitions"
    },
    {
      "description": "Track stable development-tool patches separately so they can use a longer release age.",
      "matchManagers": ["npm", "bun"],
      "matchDepTypes": ["devDependencies"],
      "matchCurrentVersion": ">=1.0.0",
      "matchPackageNames": ["eslint-*", "vite", "rimraf"],
      "separateMinorPatch": true
    },
    {
      "description": "Wait three days before merging selected stable development-tool patches.",
      "matchManagers": ["npm", "bun"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": ">=1.0.0",
      "matchPackageNames": ["eslint-*", "vite", "rimraf"],
      "groupName": "development tooling patches",
      "minimumReleaseAge": "3 days",
      "constraintsFiltering": "strict"
    },
    {
      "description": "Respect declared Node engines for runtime, documentation, and shared-config dependencies.",
      "matchManagers": ["npm", "bun"],
      "matchDepTypes": ["dependencies", "optionalDependencies"],
      "constraintsFiltering": "strict"
    },
    {
      "description": "Preserve existing consumer support when proposing peer range extensions.",
      "matchManagers": ["npm", "bun"],
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen",
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "Keep Node types aligned with the Node 26 development and CI runtime.",
      "matchManagers": ["npm", "bun"],
      "matchPackageNames": ["@types/node"],
      "allowedVersions": ">=26.0.0 <27.0.0"
    },
    {
      "description": "Node support is a deliberate library compatibility decision.",
      "matchManagers": ["npm", "bun"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "description": "Keep the Node 26 CI runtime deliberate while updating action versions separately.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["node"],
      "enabled": false
    },
    {
      "description": "Keep unrelated pre-1.0 packages separate so CI checks each upgrade independently.",
      "matchManagers": ["npm", "bun"],
      "matchCurrentVersion": "<1.0.0",
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "Unrelated major upgrades stay separate and require review.",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "groupSlug": null,
      "automerge": false
    },
    {
      "description": "Keep the runtime pin and every packageManager declaration on the same Bun release.",
      "matchManagers": ["npm", "bun", "bun-version"],
      "matchPackageNames": ["bun"],
      "groupName": "bun",
      "groupSlug": "bun",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },
    {
      "description": "Group GitHub Actions updates, keeping majors separate from minor and patch updates.",
      "matchManagers": ["github-actions"],
      "matchDatasources": ["github-tags"],
      "groupName": "github actions",
      "groupSlug": "github-actions",
      "separateMajorMinor": true,
      "separateMinorPatch": false
    }
  ]
}
