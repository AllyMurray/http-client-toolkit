{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "declaration": true,
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["bun", "node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "files": [],
  "references": [
    {
      "path": "./packages/tsdown-config/tsconfig.json"
    },
    {
      "path": "./packages/core/tsconfig.json"
    },
    {
      "path": "./packages/store-memory/tsconfig.json"
    },
    {
      "path": "./packages/store-sqlite/tsconfig.json"
    },
    {
      "path": "./packages/store-dynamodb/tsconfig.json"
    },
    {
      "path": "./packages/dashboard/tsconfig.json"
    }
  ]
}
